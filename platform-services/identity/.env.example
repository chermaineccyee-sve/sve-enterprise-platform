# SVE Identity & Access Foundation — environment variables
#
# Names and safe placeholders only, verified against the code that actually
# reads them (src/server.ts, src/container.ts, src/crypto/mfaSecretCipher.ts)
# — never real values. Copy to a real .env for local `npm run dev` /
# `npm run migrate` use; never commit the real file (.gitignore already
# excludes .env/.env.* at the repo root).

# --- Database (required) ---
DATABASE_URL=postgresql://sve_identity:replace-with-a-real-password@localhost:5432/sve_identity_dev

# --- MFA secret encryption (required) ---
# Base64-encoded 256-bit (32-byte) key used to encrypt stored TOTP secrets
# with AES-256-GCM (see src/crypto/mfaSecretCipher.ts). Resolved through the
# SecretsProvider abstraction (src/config/envSecretsProvider.ts locally/on
# SVE's private server; a future AWS deployment can supply the same key via
# Secrets Manager/KMS behind an alternative SecretsProvider implementation,
# with no code change here). Generate one with:
#   openssl rand -base64 32
# Losing or rotating this key without a migration plan makes existing
# enrolled TOTP secrets undecryptable — treat it with the same care as a
# database credential.
SVE_IDENTITY_MFA_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# --- SVEGIP session bridge (optional) ---
# Only needed to authenticate /api/v1/data-vault/* requests carrying
# apps/svegip's own `svegip_session` cookie during the transitional period
# before SVEGIP is migrated onto this Identity service (see
# src/services/svegipSessionBridge.ts and docs/architecture/
# data-vault-foundation.md "SVEGIP/Identity transitional authentication
# boundary"). Must be set to the EXACT SAME value as SVEGIP's own
# SVEGIP_SESSION_SECRET (apps/svegip/netlify/functions/_auth-core.mts) —
# this is not a new secret, it lets this service verify signatures SVEGIP
# already produces. If unset, requests using only a SVEGIP cookie are
# simply not authenticated (never a crash, never a trust fallback).
SVEGIP_SESSION_SECRET=replace-with-the-same-value-configured-in-svegip

# --- Local dev server (optional) ---
PORT=4001
