# SVE Workflow & Approval Foundation — environment variables
#
# Names and safe placeholders only, verified against the code that reads
# them. Copy to a real .env for local `npm run dev` / `npm run migrate`
# use; never commit the real file.

# --- Database (required) ---
# Same physical database as platform-services/identity, organisation, and
# hrms — this package's tables (005_workflow-approval-foundation) live
# alongside theirs; there is one shared Postgres database, not four.
DATABASE_URL=postgresql://sve_identity:replace-with-a-real-password@localhost:5432/sve_identity_dev

# --- Local dev server (optional) ---
PORT=4005
