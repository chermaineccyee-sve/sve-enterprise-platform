# SVE Organisation + Employee Master — environment variables
#
# Names and safe placeholders only, verified against the code that reads
# them. Copy to a real .env for local `npm run dev` / `npm run migrate`
# use; never commit the real file.

# --- Database (required) ---
# Same physical database as platform-services/identity and
# platform-services/data-vault — this package's tables
# (003_organisation-employee-master) live alongside theirs; there is one
# shared Postgres database, not three.
DATABASE_URL=postgresql://sve_identity:replace-with-a-real-password@localhost:5432/sve_identity_dev

# --- Local dev server (optional) ---
PORT=4003
