# Executive Vault (Personal Executive Command Centre) — environment variables
#
# Names and safe placeholders only, verified against every Netlify.env.get(...)
# call in netlify/functions/*.mts — never real values. Copy to a real .env for
# local `netlify dev` use; never commit the real file (.gitignore already
# excludes .env/.env.* at the repo root, per CONTRIBUTING.md).
#
# This covers Layer 1 (the Executive Command Centre Login) and the Google
# Calendar v1 integration (docs/architecture/executive-command-centre-
# authentication.md; provider-neutral design shared with the still-deferred
# Microsoft Outlook integration — see docs/architecture/
# outlook-calendar-readiness-review.md). Outlook itself has its own,
# separate environment variables (MICROSOFT_*), not added here, and no
# Microsoft credential is ever requested or stored by anything in this file.

# --- Session signing (required) ---
# HMAC-SHA256 signing secret for the execvault_session cookie. Used by
# netlify/functions/{login,session,logout,_auth-core}.mts. Must be a long,
# random, non-empty string — if unset, login/session endpoints respond 503.
EXECUTIVE_VAULT_SESSION_SECRET=replace-with-a-long-random-secret

# --- One-time single-user bootstrap (required only once) ---
# Shared secret checked against the x-bootstrap-secret request header by
# netlify/functions/bootstrap-user.mts, used exactly once to create the
# single authorised account (Ching Yee) with her own chosen email/password.
# The endpoint self-disables once command_centre_users has its first row,
# regardless of this value. Unset/remove this variable again after that —
# it is a one-time provisioning mechanism, not a standing application
# password.
EXECUTIVE_VAULT_BOOTSTRAP_SECRET=replace-with-a-temporary-bootstrap-secret

# --- Database (provisioned automatically, not set manually) ---
# getDatabase() from @netlify/database resolves its Postgres/Neon connection
# from Netlify's own Netlify DB integration (same mechanism apps/svegip
# already relies on) — there is no separate DATABASE_URL to set by hand.

# --- Google Calendar v1 (read-only, calendar.readonly scope only) ---
# OAuth 2.0 Web application client from Google Cloud Console. Used by
# netlify/functions/{calendar-connect,calendar-google-callback,calendar-events,
# _calendar-google}.mts. The Client ID is not secret; the Client Secret is
# and must never reach frontend JavaScript.
GOOGLE_CALENDAR_CLIENT_ID=replace-with-your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=replace-with-your-oauth-client-secret
# Exact-match HTTPS redirect URI registered with Google — must be identical,
# including scheme/host/path, to what's configured in Google Cloud Console.
GOOGLE_CALENDAR_REDIRECT_URI=https://executive-command-centre-tqje.netlify.app/api/calendar/google/callback

# --- Calendar token encryption (required, provider-neutral) ---
# AES-256-GCM key (32 raw bytes, base64) for encrypting stored OAuth access/
# refresh tokens at rest in calendar_connections — used by
# netlify/functions/_calendar-crypto.mts, and will be reused unchanged for
# Microsoft Outlook's tokens once that integration is built, rather than a
# second key. Generate the same way as this repo's other at-rest encryption
# keys: `openssl rand -base64 32`.
EXECUTIVE_VAULT_TOKEN_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32
