# Executive Vault (Personal Executive Command Centre) — environment variables
#
# Names and safe placeholders only, verified against every Netlify.env.get(...)
# call in netlify/functions/*.mts — never real values. Copy to a real .env for
# local `netlify dev` use; never commit the real file (.gitignore already
# excludes .env/.env.* at the repo root, per CONTRIBUTING.md).
#
# This covers Layer 1 only — the Executive Command Centre Login (docs/
# architecture/executive-command-centre-authentication.md). It has nothing to
# do with the future Layer 2 Microsoft Account Connection (Outlook OAuth):
# that is a separate, later phase (docs/architecture/
# outlook-calendar-readiness-review.md) with its own environment variables,
# not added here, and no Microsoft credential is ever requested or stored by
# anything in this file.

# --- Session signing (required) ---
# HMAC-SHA256 signing secret for the execvault_session cookie. Used by
# netlify/functions/{login,session,logout,_auth-core}.mts. Must be a long,
# random, non-empty string — if unset, login/session endpoints respond 503.
EXECUTIVE_VAULT_SESSION_SECRET=replace-with-a-long-random-secret

# --- One-time single-user bootstrap (required only once) ---
# Shared secret checked against the x-bootstrap-secret request header by
# netlify/functions/bootstrap-user.mts, used exactly once to create the
# single authorised account (Ching Yee) with her own chosen email/password.
# The endpoint self-disables once command_centre_users has its first row,
# regardless of this value. Unset/remove this variable again after that —
# it is a one-time provisioning mechanism, not a standing application
# password.
EXECUTIVE_VAULT_BOOTSTRAP_SECRET=replace-with-a-temporary-bootstrap-secret

# --- Database (provisioned automatically, not set manually) ---
# getDatabase() from @netlify/database resolves its Postgres/Neon connection
# from Netlify's own Netlify DB integration (same mechanism apps/svegip
# already relies on) — there is no separate DATABASE_URL to set by hand.
