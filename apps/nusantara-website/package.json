{
  "name": "nusantara-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:review": "NUSANTARA_ENV=review MARKET_DATA_PROVIDER=illustrative next build",
    "start:review": "NUSANTARA_ENV=review MARKET_DATA_PROVIDER=illustrative next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "payload": "payload",
    "cms:generate": "payload generate:importmap && payload generate:types",
    "cms:migrate": "payload migrate",
    "cms:migrate:create": "payload migrate:create",
    "cms:seed-admin": "payload run src/cms/scripts/seed-admin.ts",
    "cms:verify-workflow": "NODE_OPTIONS=--conditions=react-server payload run src/cms/scripts/verify-workflow.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "graphql": "16.14.2",
    "motion": "13.5.0",
    "next": "16.3.8",
    "payload": "3.90.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "description": "Nusantara Fund Management public website (management-review prototype). Self-contained Next.js app."
}
