# Nusantara website + Admin Portal — environment variables.
# Copy to .env for local development. Never commit real values.
# In hosting (Netlify), set these in the site's environment settings.

# --- Website ------------------------------------------------------------
# review (default) | staging | production. See src/lib/config.ts.
NUSANTARA_ENV=review
# illustrative in review; an approved provider id in staging/production.
MARKET_DATA_PROVIDER=illustrative
# Production only: indexing is a management decision. allow | (unset = none)
# SITE_INDEXING=
# Public origin of the site (also the Admin Portal's CSRF/CORS origin).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Content source -------------------------------------------------------
# local (default): typed files in src/content — no database needed.
# cms: the Admin Portal database, published content only (B1 onward).
CONTENT_SOURCE=local

# --- Admin Portal (Payload CMS) ------------------------------------------
# Postgres connection string. Production: Neon, Singapore (ap-southeast-1), sslmode=require.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# Long random string (at least 32 bytes, e.g. `openssl rand -hex 32`). Signs session tokens.
PAYLOAD_SECRET=
# Bootstrap only: allow creating the first Admin through /admin while no user exists.
# Leave unset (false) at all other times. Prefer `npm run cms:seed-admin`.
# CMS_ALLOW_FIRST_USER=false
# Additional allowed origins for authenticated Admin requests (comma-separated), e.g. a deploy-preview URL.
# CMS_EXTRA_ORIGINS=

# --- Media storage (production) -------------------------------------------
# When S3_BUCKET is set, media uploads go to S3; otherwise to local ./media (development).
# S3_BUCKET=
# S3_REGION=ap-southeast-1
# Optional when the runtime provides AWS credentials another way:
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Contact form (existing) ----------------------------------------------
# none (default) | webhook. See src/lib/contact-delivery.ts.
# CONTACT_DELIVERY=
# CONTACT_WEBHOOK_URL=
# CONTACT_WEBHOOK_SECRET=
