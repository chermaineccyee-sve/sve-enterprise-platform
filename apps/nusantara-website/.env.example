# Nusantara website + Admin Portal — environment variables.
# Copy to .env for local development. Never commit real values.
# In hosting (Netlify), set these in the site's environment settings.

# --- Website ------------------------------------------------------------
# review (default) | staging | production. See src/lib/config.ts.
NUSANTARA_ENV=review
# illustrative in review; an approved provider id in staging/production.
MARKET_DATA_PROVIDER=illustrative
# Production only: indexing is a management decision. allow | (unset = none)
# SITE_INDEXING=
# Public origin of the site (also the Admin Portal's CSRF/CORS origin).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Content source -------------------------------------------------------
# local (default): typed files in src/content — no database needed.
# cms: the Admin Portal database, published content only (B1 onward).
CONTENT_SOURCE=local

# --- Admin Portal (Payload CMS) ------------------------------------------
# Full matrix (production / branch deploy / deploy preview / local): docs/DEPLOYMENT.md.
# Which data set this deployment may touch: production | preview | development (local default).
# CMS_DATA_ENV=development
# Runtime connection. Production/preview: Neon's POOLED endpoint (host contains -pooler), TLS required:
#   postgresql://ROLE:PASSWORD@ep-…-pooler.ap-southeast-1.aws.neon.tech/nusantara_cms?sslmode=verify-full
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# Schema work (migrations, import, seed): Neon's DIRECT endpoint (no -pooler). Optional locally.
# DATABASE_URL_UNPOOLED=
# Long random string (at least 32 characters, e.g. `openssl rand -hex 32`). Signs session tokens.
PAYLOAD_SECRET=
# Bootstrap only: set (openssl rand -hex 32) to open /admin/bootstrap while NO account exists;
# remove it once the first Admin has signed in. Alternative: `npm run cms:seed-admin`.
# CMS_BOOTSTRAP_TOKEN=
# Additional allowed origins for authenticated Admin requests (comma-separated https:// origins).
# CMS_EXTRA_ORIGINS=
# Deploy step (scripts/cms/deploy.mjs): migrations policy — check (production default) | apply.
# CMS_MIGRATIONS=
# Named approval for one destructive migration, e.g. CMS_ALLOW_DESTRUCTIVE_MIGRATION=20270101_000000_drop_x
# CMS_ALLOW_DESTRUCTIVE_MIGRATION=
# true: run the idempotent content import during the deploy step (initial load).
# CMS_IMPORT_ON_DEPLOY=
# Connections per function instance (default 3 deployed, 5 locally).
# CMS_DB_POOL_MAX=

# --- Media storage ----------------------------------------------------------
# When S3_BUCKET is set, media uploads go to that PRIVATE bucket; otherwise to local ./media (development).
# S3_BUCKET=
# S3_REGION=ap-southeast-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Local testing only (an S3-compatible server); never set in Netlify.
# S3_ENDPOINT=

# --- Contact form (existing) ----------------------------------------------
# none (default) | webhook. See src/lib/contact-delivery.ts.
# CONTACT_DELIVERY=
# CONTACT_WEBHOOK_URL=
# CONTACT_WEBHOOK_SECRET=
