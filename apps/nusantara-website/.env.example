# Nusantara website — environment configuration.
# Copy to .env.local (never committed). Values are read at build/deploy time;
# changing environment is a configuration change and a redeploy, not a code change.
# Variables without NEXT_PUBLIC_ are server-only and never reach the browser.

# ---- Environment: prototype | staging | production --------------------------
#  prototype  → illustrative data, prototype banner, no indexing, sample content (labelled)
#  staging    → test integrations, no indexing, approved + published content
#  production → published content only, no prototype banner, indexing per SITE_INDEXING
NUSANTARA_ENV=prototype

# Public site URL (canonical links, sitemap, social cards)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Production only: allow search-engine indexing once management decides (default: excluded)
# SITE_INDEXING=allow

# ---- Market data -----------------------------------------------------------
#  illustrative (prototype default) | http (approved API / licensed-vendor gateway)
#  In staging/production with no provider configured, every value shows as "Unavailable".
MARKET_DATA_PROVIDER=illustrative
# MARKET_DATA_API_URL=https://market-data.example.com/v1
# MARKET_DATA_API_KEY=            # secret — server-side only
# MARKET_DATA_SOURCE_NAME="Approved data provider"

# ---- Contact enquiries -----------------------------------------------------
#  none (default): validated, then neither stored nor sent
#  webhook: POST signed JSON to the approved delivery service
CONTACT_DELIVERY=none
# CONTACT_WEBHOOK_URL=https://…
# CONTACT_WEBHOOK_SECRET=         # secret — HMAC-SHA256 signing key
