# SVEGIP environment variables
#
# Verified against the application source (grepped every Netlify.env.get(...) call
# in netlify/functions/*.mts) rather than assumed. Copy to a real .env for local
# `netlify dev` use and fill in your own values — never commit the real file.

# --- Session signing (required) ---
# HMAC-SHA256 signing secret for the svegip_session cookie. Used by
# netlify/functions/{login,session,_auth-core}.mts. Must be a long, random,
# non-empty string — if unset, login/session endpoints respond 503.
SVEGIP_SESSION_SECRET=replace-with-a-long-random-secret

# --- First-admin bootstrap (required only for the one-time bootstrap flow) ---
# Shared secret checked against the x-bootstrap-secret request header by
# netlify/functions/bootstrap-admin.mts. The endpoint self-disables once the
# employee_accounts table has its first row, regardless of this value.
# Unset/remove this variable again after the first Administrator is created.
SVEGIP_BOOTSTRAP_SECRET=replace-with-a-temporary-bootstrap-secret

# --- Database (provisioned automatically, not set manually) ---
# getDatabase() from @netlify/database resolves its Postgres/Neon connection
# from Netlify's own Netlify DB integration (injected automatically by the
# Netlify CLI/runtime when this site has Netlify DB enabled). There is no
# separate DATABASE_URL or similar variable to set by hand for this app.
