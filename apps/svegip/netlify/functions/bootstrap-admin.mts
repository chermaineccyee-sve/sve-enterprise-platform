import type { Context, Config } from "@netlify/functions";import { getDatabase } from "@netlify/database";const te=new TextEncoder();function b64(b:Uint8Array){return btoa(String.fromCharCode(...b))}async function hp(p:string){const salt=crypto.getRandomValues(new Uint8Array(16)),iterations=210000,k=await crypto.subtle.importKey("raw",te.encode(p),"PBKDF2",false,["deriveBits"]),bits=await crypto.subtle.deriveBits({name:"PBKDF2",hash:"SHA-256",salt,iterations},k,256);return{salt:b64(salt),hash:b64(new Uint8Array(bits)),iterations}}
export default async(req:Request,context:Context)=>{if(req.method!=="POST")return new Response("Method Not Allowed",{status:405});const expected=Netlify.env.get("SVEGIP_BOOTSTRAP_SECRET"),provided=req.headers.get("x-bootstrap-secret");if(!expected||provided!==expected)return Response.json({error:"Forbidden"},{status:403});const db=getDatabase(),[count]=await db.sql`SELECT COUNT(*)::int AS count FROM employee_accounts`;if(count.count>0)return Response.json({error:"Bootstrap is disabled after the first account exists."},{status:409});const {email,name,password}=await req.json().catch(()=>({}));if(!email||!name||String(password||"").length<12)return Response.json({error:"Valid email, name and password required."},{status:400});const h=await hp(String(password));await db.sql`INSERT INTO employee_accounts(email,name,role,unit,status,data_vault_access,permissions,password_salt,password_hash,password_iterations) VALUES(${String(email).toLowerCase()},${name},${"Administrator"},${"SVE"},${"Active"},${true},${JSON.stringify(["accounts.manage","vault.admin","vault.audit","decisions.manage"])}::jsonb,${h.salt},${h.hash},${h.iterations})`;await db.sql`INSERT INTO employee_account_audit(employee_email,action,performed_by,details) VALUES(${String(email).toLowerCase()},${"BOOTSTRAP_ADMIN"},${String(email).toLowerCase()},${JSON.stringify({role:"Administrator",unit:"SVE",dataVaultAccess:true})}::jsonb)`;return Response.json({ok:true},{status:201})};export const config:Config={path:"/api/bootstrap-admin"};