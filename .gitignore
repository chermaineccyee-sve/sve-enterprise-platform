# SVE Group Enterprise Platform — root .gitignore
# Applies to the whole monorepo (apps/*, platform-services/*, etc.)
# Intentionally does NOT ignore: source code, database migrations, documentation,
# deployment config (netlify.toml, vercel.json), or *.env.example files.

# --- Dependencies ---
node_modules/
jspm_packages/

# --- Build / bundler output ---
dist/
build/
out/
.cache/
.parcel-cache/
.turbo/
.next/
.nuxt/
.svelte-kit/
*.tsbuildinfo

# --- Netlify local state ---
.netlify/

# --- Environment files (never commit real secrets) ---
.env
.env.*
!.env.example
!*.env.example

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Test / coverage output ---
coverage/
.nyc_output/

# --- OS files ---
.DS_Store
Thumbs.db

# --- Editor / IDE files ---
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# --- Misc local artifacts ---
*.local
.tmp/
tmp/
